# VITE_SHEETS_WEB_APP_URL: Default Google Apps Script Web App endpoint the app
# syncs against. Baked into the client bundle at build time, so treat it as
# public — anyone with the deployed page can call it. Leave empty to ship in
# local-only mode; users then paste their own URL in the Google Sheets tab.
#
# For GitHub Pages, set this as a repository *variable* named
# VITE_SHEETS_WEB_APP_URL (Settings > Secrets and variables > Actions > Variables)
# rather than committing it here.
VITE_SHEETS_WEB_APP_URL=""

# BASE_PATH: Path the production build is served from. Must match how the site
# is actually hosted or every asset 404s.
#   "/"          root of a domain (this deployment: appvault.lexostudio.gm)
#   "/appvault/" GitHub Pages project site without a custom domain
BASE_PATH="/"
